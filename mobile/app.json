{
  "expo": {
    "name": "MyHome OS",
    "slug": "myhome-os",
    "owner": "myhome-os",
    "scheme": "myhomeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F8F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myhomeos.app"
    },
    "android": {
      "package": "com.myhomeos.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2fb325b4-1bc3-4cb3-87c6-5d64dff41f22"
      }
    }
  }
}
